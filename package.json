{
  "name": "hardhat-project",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "hardhat": "^2.25.0",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.0.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.7.0",
    "dotenv": "^17.0.1",
    "husky": "^9.1.7"
  },
  "scripts": {
    "prepare": "husky",
    "compile": "npx hardhat compile",
    "deploy:license": "npx hardhat ignition deploy './ignition/modules/LicenseContract.js' --network sepolia",
    "deploy:license-factory": "npx hardhat ignition deploy './ignition/modules/LicenseFactory.js' --network sepolia",
    "deploy:primary-marketplace": "npx hardhat ignition deploy './ignition/modules/PrimaryMarketPlace.js' --network sepolia",
    "deploy:secondary-marketplace": "npx hardhat ignition deploy './ignition/modules/SecondaryMarketPlace.js' --network sepolia",
    "lint": "solhint 'contracts/**/*.sol'",
    "check:format": "prettier --list-different --plugin=prettier-plugin-solidity 'contracts/**/*.sol'",
    "format": "npx prettier --write --plugin=prettier-plugin-solidity 'contracts/**/*.sol'",
    "dev-example": "cd dev-example && npm install --legacy-peer-deps && npm run dev"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
