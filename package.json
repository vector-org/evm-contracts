{
  "name": "foundry-project",
  "devDependencies": {
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.0.0"
  },
  "dependencies": {
    "dotenv": "^17.1.0",
    "husky": "^9.1.7",
    "solhint": "^6.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "compile": "forge build",
    "deploy:master": "forge script script/MasterDeployment.s.sol:MasterDeployment --rpc-url sepolia --broadcast --verify",
    "deploy:license": "forge script script/DeployLicenseContract.s.sol:DeployLicenseContract --rpc-url sepolia --broadcast --verify",
    "deploy:license-factory": "forge script script/DeployLicenseFactory.s.sol:DeployLicenseFactory --rpc-url sepolia --broadcast --verify",
    "deploy:primary-marketplace": "forge script script/DeployPrimaryMarketPlace.s.sol:DeployPrimaryMarketPlace --rpc-url sepolia --broadcast --verify",
    "deploy:secondary-marketplace": "forge script script/DeploySecondaryMarketPlace.s.sol:DeploySecondaryMarketPlace --rpc-url sepolia --broadcast --verify",
    "test": "forge test",
    "lint": "solhint 'src/**/*.sol'",
    "check:format": "prettier --list-different --plugin=prettier-plugin-solidity 'src/**/*.sol'",
    "format": "prettier --write --plugin=prettier-plugin-solidity 'src/**/*.sol'",
    "dev-example:install": "cd dev-example && npm install --legacy-peer-deps",
    "dev-example:dev": "cd dev-example && npm run dev",
    "dev-example:build": "cd dev-example && npm run build"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
