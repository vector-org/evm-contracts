{
  "name": "hardhat-project",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.25.0",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.0.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.7.0",
    "dotenv": "^17.0.1",
    "husky": "^9.1.7"
  },
  "scripts": {
    "prepare": "husky",
    "compile": "npx hardhat compile",
    "deploy": "npx hardhat deploy --network sepolia",
    "lint": "solhint 'contracts/**/*.sol'",
    "check:format": "prettier --list-different --plugin=prettier-plugin-solidity 'contracts/**/*.sol'",
    "format": "npx prettier --write --plugin=prettier-plugin-solidity 'contracts/**/*.sol'"
  }
}
