{
  "name": "foundry-project",
  "devDependencies": {
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.1.0"
  },
  "dependencies": {
    "dotenv": "^17.1.0",
    "husky": "^9.1.7",
    "solhint": "^6.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "compile": "forge build",
    "deploy:master-proxy": "forge script script/deploy/MasterDeployment.s.sol:MasterProxyDeployment --rpc-url sepolia --broadcast --verify",
    "deploy:master-proxy:vector": "forge script script/deploy/MasterDeployment.s.sol:MasterProxyDeployment --rpc-url vector --broadcast --slow",
    "deploy:factory-proxy": "forge script script/deploy/DeployLicenseFactory.s.sol:DeployLicenseFactoryProxy --rpc-url sepolia --broadcast --verify",
    "deploy:factory-proxy:vector": "forge script script/deploy/DeployLicenseFactory.s.sol:DeployLicenseFactoryProxy --rpc-url vector --broadcast --slow",
    "deploy:primary-proxy": "forge script script/deploy/DeployPrimaryMarketPlace.s.sol:DeployPrimaryMarketPlaceProxy --rpc-url sepolia --broadcast --verify",
    "deploy:primary-proxy:vector": "forge script script/deploy/DeployPrimaryMarketPlace.s.sol:DeployPrimaryMarketPlaceProxy --rpc-url vector --broadcast --slow",
    "deploy:secondary-proxy": "forge script script/deploy/DeploySecondaryMarketPlace.s.sol:DeploySecondaryMarketPlaceProxy --rpc-url sepolia --broadcast --verify",
    "deploy:secondary-proxy:vector": "forge script script/deploy/DeploySecondaryMarketPlace.s.sol:DeploySecondaryMarketPlaceProxy --rpc-url vector --broadcast --slow",
    "upgrade:master": "forge script script/deploy/MasterDeployment.s.sol:MasterUpgrade --rpc-url sepolia --broadcast --verify",
    "upgrade:master:vector": "forge script script/deploy/MasterDeployment.s.sol:MasterUpgrade --rpc-url vector --broadcast --slow",
    "upgrade:factory": "forge script script/deploy/DeployLicenseFactory.s.sol:DeployLicenseFactory --rpc-url sepolia --broadcast --verify",
    "upgrade:factory:vector": "forge script script/deploy/DeployLicenseFactory.s.sol:DeployLicenseFactory --rpc-url vector --broadcast --slow",
    "upgrade:primary": "forge script script/deploy/DeployPrimaryMarketPlace.s.sol:DeployPrimaryMarketPlace --rpc-url sepolia --broadcast --verify",
    "upgrade:primary:vector": "forge script script/deploy/DeployPrimaryMarketPlace.s.sol:DeployPrimaryMarketPlace --rpc-url vector --broadcast --slow",
    "upgrade:secondary": "forge script script/deploy/DeploySecondaryMarketPlace.s.sol:DeploySecondaryMarketPlace --rpc-url sepolia --broadcast --verify",
    "upgrade:secondary:vector": "forge script script/deploy/DeploySecondaryMarketPlace.s.sol:DeploySecondaryMarketPlace --rpc-url vector --broadcast --slow",
    "export:vector": "node script/export-contract.js --script MasterDeployment.s.sol",
    "test": "forge test",
    "test:gas": "forge test --gas-report",
    "forge:lint": "forge lint --severity high --severity gas",
    "lint": "solhint 'src/**/*.sol'",
    "cast:setSecondaryOnPrimary": "source .env && cast send $PRIMARY_PROXY_ADDRESS 'setSecondaryMarketPlace(address)' $SECONDARY_PROXY_ADDRESS --private-key $PRIVATE_KEY --rpc-url vector",
    "format:check": "prettier --list-different --plugin=prettier-plugin-solidity 'src/**/*.sol'",
    "format:fix": "prettier --write --plugin=prettier-plugin-solidity '**/*.sol'",
    "contracts:static-analysis": "slither .",
    "dev-example:install": "cd dev-example && npm install --legacy-peer-deps",
    "dev-example:dev": "cd dev-example && npm run dev",
    "dev-example:build": "cd dev-example && npm run build",
    "deploy:license": "forge script script/deploy/DeployLicenseContract.s.sol:DeployLicenseContract --rpc-url sepolia --broadcast --verify",
    "ops:pause": "forge script script/ops/PauseAll.s.sol:PauseAll --rpc-url vector --broadcast --slow",
    "ops:unpause": "forge script script/ops/UnpauseAll.s.sol:UnpauseAll --rpc-url vector --broadcast --slow",
    "ops:setSecondary": "forge script script/ops/SetSecondaryOnPrimary.s.sol:SetSecondaryOnPrimary --rpc-url vector --broadcast --slow --sig 'run(address)' --",
    "ops:addCoordinator": "forge script script/ops/CoordinatorManager.s.sol:CoordinatorManager --rpc-url vector --broadcast --slow --sig 'run(address,bool)' --",
    "ops:createLicense": "forge script script/ops/CreateLicense.s.sol:CreateLicense --rpc-url vector --broadcast --slow --sig 'run(string,string,string,bool,uint256,address,address,address)' --",
    "ops:mint": "forge script script/ops/MintOnPrimary.s.sol:MintOnPrimary --rpc-url vector --broadcast --slow --sig 'run(uint256,address)' --",
    "ops:mint:uri": "forge script script/ops/MintOnPrimary.s.sol:MintOnPrimary --rpc-url vector --broadcast --slow --sig 'run(uint256,address,string)' --",
    "ops:approveSecondary": "forge script script/ops/ApproveForSecondary.s.sol:ApproveForSecondary --rpc-url vector --broadcast --slow --sig 'run(address,bool)' --",
    "ops:offer:create": "forge script script/ops/CreateSecondaryOffer.s.sol:CreateSecondaryOffer --rpc-url vector --broadcast --slow --sig 'run(uint256,address,uint256)' --",
    "ops:offer:accept": "forge script script/ops/AcceptSecondaryOffer.s.sol:AcceptSecondaryOffer --rpc-url vector --broadcast --slow --sig 'run(uint256,uint256)' --",
    "ops:offer:remove": "forge script script/ops/RemoveSecondaryOffer.s.sol:RemoveSecondaryOffer --rpc-url vector --broadcast --slow --sig 'run(uint256)' --",
    "ops:dump": "forge script script/ops/DumpState.s.sol:DumpState --rpc-url vector",
    "ops:seed": "forge script script/ops/MintGames.s.sol --rpc-url vector --broadcast --slow"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}